{
  "name": "Mi Panel Demo",
  "id": "com.estudio35.mipanel",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PPro",
    "minVersion": "25.6"
  },
  "manifestVersion": 5,
  "entrypoints": [
    {
      "type": "panel",
      "id": "mipanel",
      "label": {
        "default": "Mi Panel Demo"
      },
      "minimumSize": { "width": 200, "height": 100 },
      "maximumSize": { "width": 800, "height": 600 },
      "preferredDockedSize": { "width": 300, "height": 400 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": "none"
    }
  }
}
